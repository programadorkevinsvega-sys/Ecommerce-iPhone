{
  "name": "ecommerce-iphone",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "preinstall": "node scripts/verify-install.mjs",
    "dev": "pnpm --filter @ecommerce/web dev",
    "build": "pnpm --filter @ecommerce/web build",
    "build:cloudflare": "pnpm --filter @ecommerce/web build:cloudflare",
    "preview:cloudflare": "pnpm --filter @ecommerce/web preview:cloudflare",
    "start": "pnpm --filter @ecommerce/web start",
    "deploy": "pnpm deploy:production",
    "deploy:cloudflare": "pnpm build:cloudflare && pnpm cloudflare:deploy:production",
    "deploy:production": "pnpm build:cloudflare && pnpm cloudflare:deploy:production",
    "verify:production": "node scripts/verify-production.mjs",
    "performance:production": "pnpm --filter @ecommerce/web exec node ../../scripts/performance-smoke.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply ecommerce-iphone --local",
    "db:migrate:production": "wrangler d1 migrations apply ecommerce-iphone --remote",
    "db:migration:list": "wrangler d1 migrations list DB --remote",
    "architecture:check": "node scripts/check-architecture.mjs",
    "foundation:check": "node scripts/check-foundation.mjs",
    "frontend:data:check": "node scripts/check-frontend-production-data.mjs",
    "lint": "pnpm --filter @ecommerce/web lint",
    "typecheck": "pnpm --filter @ecommerce/web typecheck",
    "test": "pnpm --filter @ecommerce/web test",
    "test:e2e": "pnpm --filter @ecommerce/web test:e2e",
    "format": "node scripts/format-repository.mjs",
    "format:check": "prettier --check .",
    "verify:admin:production": "node scripts/verify-admin-production.mjs",
    "cloudflare:build": "pnpm build:cloudflare",
    "cloudflare:deploy": "echo 'Production deployment is managed by GitHub Actions; Workers Builds deployment is intentionally disabled.'",
    "cloudflare:version": "pnpm exec wrangler --version",
    "verify:notifications:production": "node scripts/verify-notifications-production.mjs",
    "db:verify:production": "pnpm exec wrangler d1 migrations list DB --remote",
    "verify:phase08:production": "node scripts/verify-phase08-production.mjs",
    "verify:phase09:production": "node scripts/verify-phase09-production.mjs",
    "verify:phase10.2:production": "node scripts/verify-phase10.2-production.mjs",
    "verify:phase10.3:production": "node scripts/verify-phase10.3-production.mjs",
    "verify:phase10.4:production": "node scripts/verify-phase10.4-production.mjs",
    "verify:phase10.5:production": "node scripts/verify-phase10.5-production.mjs",
    "cloudflare:deploy:production": "node scripts/assert-main-deploy.mjs && pnpm db:migrate:production && pnpm exec wrangler deploy --env=\"\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "prettier": "^3.6.2",
    "wrangler": "4.155.0"
  }
}
