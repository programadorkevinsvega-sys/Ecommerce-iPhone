{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:8787/",
        "http://127.0.0.1:8787/catalog",
        "http://127.0.0.1:8787/iphone/iphone-17-pro-max",
        "http://127.0.0.1:8787/cart",
        "http://127.0.0.1:8787/checkout",
        "http://127.0.0.1:8787/admin/login"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:8787/.*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ],
            "first-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1800,
                "aggregationMethod": "median"
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500,
                "aggregationMethod": "median"
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200,
                "aggregationMethod": "median"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:8787/(?:$|catalog/?$|iphone/iphone-17-pro-max/?$)",
          "assertions": {
            "categories:seo": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouseci"
    }
  }
}
